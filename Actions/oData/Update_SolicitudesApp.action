{
	"_Type": "Action.Type.ODataService.UpdateEntity",
	"ActionResult": {
		"_Name": "Update_SolicitudesApp"
	},
	"OnFailure": {
		"Name": "/appconsumos_qa_mb/Actions/GenericMessageBox.action",
		"Properties": {
			"Message": "#ActionResults:Update_SolicitudesApp/error",
			"Title": "Error",
			"OKCaption": "Ok",
			"OnOK": {
				"Name": "/appconsumos_qa_mb/Actions/CloseModalPage_Cancel.action",
				"Properties": {
					"NavigateBackToPage": "Detalle_Solicitudes_Ingenio"
				}
			}
		}
	},
	"OnSuccess": "/appconsumos_qa_mb/Rules/Ingenio/Rechazar_Solicitud_Revision_Ingenio.js",
	"Target": {
		"Service": "/appconsumos_qa_mb/Services/app_consumos_qa.service",
		"EntitySet": "Solicitudes",
		"QueryOptions": "$filter=id eq {{#Page:Detalle_Solicitudes_Ingenio/#ClientData/id_de_solicitud}}"
	},
	"Properties": {
		"estado": "Rechazado"
	}
}